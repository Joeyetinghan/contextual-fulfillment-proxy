{
  "model_variant": "hierarchical_proxy_v2",
  "model_name": "hierarchical_proxy_base",
  "hidden_dim": 160,
  "n_layers": 3,
  "dropout_p": 0.2,
  "dc_embedding_dim": 64,
  "sku_emb_dim": 8,
  "brand_emb_dim": 6,
  "carrier_emb_dim": 8,
  "option_proj_dim": 8,
  "use_option_features_in_carrier": true,
  "use_scenario_module": true,
  "use_dc_module": true,
  "use_dc_embedding": true,
  "use_carrier_embedding": true,
  "agg_type": "mean",
  "label_smoothing": 0.05,
  "carrier_loss_weight": 0.002,
  "selection_weight": 1.0,
  "entropy_weight": 0.0,
  "cost_loss_weight": 0.01,
  "constraint_loss_weight": 0.2,
  "use_dc_class_weights": true,
  "dc_class_weight_power": 0.5,
  "dc_class_weight_max": 10.0,
  "use_carrier_class_weights": false,
  "carrier_class_weight_power": 1.0,
  "carrier_class_weight_max": 0.0,
  "use_cost_summary": true,
  "normalize_global_features": true,
  "normalize_dc_features": false,
  "normalize_option_features": false,
  "use_eligibility_mask": true,
  "repair_strategy": "inventory_weighted",
  "learning_rate": 0.0003,
  "weight_decay": 0.00001,
  "batch_size": 64,
  "epochs": 500,
  "early_stopping_patience": 15,
  "final_eval_on_best": true,
  "final_ub_eval_orders": 2000,
  "final_ub_eval_scenarios": 500,
  "final_ub_eval_batch_size": 256
